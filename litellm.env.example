# Copy to ./litellm.env and adjust as needed.
# PoC only — replace before production.
#
# DATABASE_URL is set on the Compose litellm service from POSTGRES_USER /
# POSTGRES_PASSWORD. Do not change LITELLM_SALT_KEY after the database has
# been initialized.
#
# The Open WebUI virtual key is created by litellm-bootstrap from
# LITELLM_OPENWEBUI_KEY. Direct API callers still create their own keys in
# the LiteLLM admin UI.

LITELLM_MASTER_KEY=sk-admin-master-key-change-me
LITELLM_SALT_KEY=sk-salt-change-me
