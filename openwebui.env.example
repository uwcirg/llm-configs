# Copy to ./openwebui.env and adjust as needed.
# PoC only — replace before production.
#
# DATABASE_URL is set on the Compose openwebui service from POSTGRES_USER /
# POSTGRES_PASSWORD.
#
# Open WebUI’s LiteLLM key is LITELLM_OPENWEBUI_KEY (Compose injects it as
# OPENAI_API_KEY and litellm-bootstrap creates it in LiteLLM). Prefer setting
# it in the project .env; the Compose default is sk-openwebui-key-change-me.

WEBUI_SECRET_KEY=poc-webui-secret-key-change-me
