# Copy to ./openwebui.env and adjust as needed.
# PoC only — replace before production.
#
# DATABASE_URL credentials must match the Postgres service defaults in
# docker-compose.yml (POSTGRES_USER / POSTGRES_PASSWORD).
#
# Open WebUI’s LiteLLM key is LITELLM_OPENWEBUI_KEY (Compose injects it as
# OPENAI_API_KEY). Prefer setting it in the project .env; the Compose default
# is sk-openwebui-key-change-me. Create the matching virtual key in the
# LiteLLM admin UI before chat will work.

DATABASE_URL=postgresql://postgres:p9Kx2mQ7vL4nR8wT@postgres:5432/openwebui
WEBUI_SECRET_KEY=poc-webui-secret-key-change-me
