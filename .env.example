# Optional overrides. docker-compose.yml already supplies working defaults.
# PoC only — replace before production.
#
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres

# Required. MIG device UUID from `nvidia-smi -L` (for example MIG-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx).
NVIDIA_VISIBLE_DEVICES=

# Optional Ollama tuning.
# OLLAMA_MAX_LOADED_MODELS=2
# OLLAMA_NUM_PARALLEL=2
# OLLAMA_MAX_QUEUE=512
# OLLAMA_KEEP_ALIVE=10m
# OLLAMA_FLASH_ATTENTION=1
