COMPOSE_PROJECT_NAME=
BASE_DOMAIN=

# Required by docker model gateway (gateway.medgemma.yaml master_key).
OAI_API_KEY=

# Required for pulling hf.co/google/medgemma-1.5-4b-it (gated model).
HUGGING_FACE_HUB_TOKEN=

# Host address of the gateway process, as seen from model-gateway-proxy (socat).
GATEWAY_UPSTREAM=host.docker.internal:4000
