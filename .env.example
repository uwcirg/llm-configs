# Optional overrides. docker-compose.yml already supplies working defaults.
# PoC only — replace before production.
#
# Required. DNS zone. Open WebUI accounts are admin@, researcher@, and user@ this name.
BASE_DOMAIN=

# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres

# Required. MIG device UUID from `nvidia-smi -L` (for example MIG-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx).
NVIDIA_VISIBLE_DEVICES=

# Optional Ollama tuning.
# OLLAMA_MAX_LOADED_MODELS=2
# OLLAMA_NUM_PARALLEL=2
# OLLAMA_MAX_QUEUE=512
# OLLAMA_KEEP_ALIVE=10m
# OLLAMA_FLASH_ATTENTION=1

# Optional LiteLLM credentials. PoC only — replace before production.
# Do not change LITELLM_SALT_KEY after the database has been initialized.
# LITELLM_MASTER_KEY=sk-admin-master-key-change-me
# LITELLM_SALT_KEY=sk-salt-change-me
# LITELLM_RESEARCHER_KEY=sk-researcher-key-change-me

# Optional Open WebUI session secret. Changing it signs everyone out.
# WEBUI_SECRET_KEY=poc-webui-secret-key-change-me
