COMPOSE_PROJECT_NAME=llm-configs

# Public hostname for the model API (DNS A record must point at this VM).
MODEL_API_FQDN=models.example.org

# Let's Encrypt account email (ACME registration).
ACME_EMAIL=ops@example.org

# Hugging Face token for gated model pulls (required for MedGemma).
HUGGING_FACE_HUB_TOKEN=

# Optional: absolute path to this checkout on the VM (default: directory containing deploy.sh).
# LLM_CONFIGS_ROOT=/opt/llm-configs

# GATEWAY_API_KEY is NOT set here. Provision it only in:
#   /etc/docker-model-gateway.env
#   GATEWAY_API_KEY=<high-entropy-secret>
# mode 0600, root-owned. Clients send Authorization: Bearer <key> or x-api-key: <key>.
