# Host-level settings used by Compose interpolation (labels, GPU device ids).
# PoC only — replace before production.
#
# Required. DNS zone for llm, models, and traefik-dashboard.
BASE_DOMAIN=

# Required. MIG device UUID from `nvidia-smi --list-gpus` (for example MIG-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx).
NVIDIA_VISIBLE_DEVICES=

# Optional Let's Encrypt account email.
# ACME_EMAIL=cirg-adm@uw.edu

# Optional. Dedicated LiteLLM virtual key for the Open WebUI service.
# Create the key in the LiteLLM admin UI, then set the same value here.
# LITELLM_OPENWEBUI_KEY=sk-openwebui-key-change-me
