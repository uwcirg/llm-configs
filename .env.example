# Host-level settings used by Compose interpolation (labels, GPU device ids).
# PoC only — replace before production.
#
# Required. DNS zone for chat, llm, and traefik-dashboard.
BASE_DOMAIN=

# Required. MIG device UUID from `nvidia-smi --list-gpus` (for example MIG-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx).
NVIDIA_VISIBLE_DEVICES=

# Optional Let's Encrypt account email.
# ACME_EMAIL=cirg-adm@uw.edu

# Optional. Dedicated LiteLLM virtual key for the Open WebUI service.
# Compose creates this key in LiteLLM on first boot (alias openwebui).
# LITELLM_OPENWEBUI_KEY=sk-openwebui-key-change-me

# Optional. Override service image tags (defaults match docker-compose.yml).
# POSTGRES_DOCKER_IMAGE_TAG=18
# OLLAMA_DOCKER_IMAGE_TAG=latest
# LITELLM_DOCKER_IMAGE_TAG=v1.106.5
# LITELLM_BOOTSTRAP_DOCKER_IMAGE_TAG=8.11.1
# OPENWEBUI_DOCKER_IMAGE_TAG=v0.12.4
# OPENWEBUI_BOOTSTRAP_DOCKER_IMAGE_TAG=8.11.1
# TRAEFIK_DOCKER_IMAGE_TAG=v3.6.25
